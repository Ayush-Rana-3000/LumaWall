{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumaWall",
  "version": "0.1.0",
  "identifier": "com.lumawall.app",
  "build": {
    "beforeDevCommand": "npm run typecheck && npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LumaWall",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: file: asset: https:; media-src 'self' blob: data: file:; connect-src 'self' ipc: http://localhost:* ws://localhost:*; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none';"
    }
  },
  "plugins": {
    "shell": {
      "open": false
    },
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/lumawall/lumawall/releases/latest/download/latest.json"
      ],
      "windows": {
        "installer": {
          "nsis": {},
          "wix": null
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "both",
        "headerImage": "icons/128x128.png",
        "sidebarImage": "icons/128x128.png",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "languages": ["English"]
      },
      "wix": null
    }
  }
}
