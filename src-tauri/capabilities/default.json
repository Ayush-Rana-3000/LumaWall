{
  "$schema": "https://raw.githubusercontent.com/nicholasrice/tauri/dev/crates/tauri-utils/schema.json",
  "identifier": "default",
  "description": "Default capabilities for LumaWall — restricts IPC to only the commands the app needs",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "updater:default"
  ]
}
